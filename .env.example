VITE_API_URL=https://olx-server-omega.vercel.app/api

# Yandex Maps JavaScript API key. Without it the "указать на карте" button is
# hidden and the delivery form works by hand only.
VITE_YANDEX_MAPS_KEY=

# Server-side only — NO VITE_ prefix, or the token ends up in the browser bundle.
# Consumed by api/order.js.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
